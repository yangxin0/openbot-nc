#!/bin/bash
set -euo pipefail
# shellcheck source=openbot-hosted-update
source "$(dirname "$(readlink -f "$0")")/openbot-hosted-update"
umask 077

SOCKET=/run/openbot-nc/control.sock
UNIT=openbot-nc.service

usage() {
  cat <<EOF
Usage: openbot-nc <command>

  status                         Show the identity, the relay connection and the server.
  import-identity <file> [--replace] [--hosting on|off]
                                 Import the identity file that the "ca issue" command of
                                 your relay server made. The server then joins its team.
                                 The user $(service_user) must be able to read the file.
                                 --replace changes an identity that the server has already.
  hosting on|off                 Share the agents of this server with the team, or stop.
  name <name>                    Change the server name.
  logs [-f]                      Show the OpenBot log.
  start | stop | restart         Control the OpenBot service (sudo).
  update <file or URL> [sha512]  Install an AppImage that you give: a local file or an https URL
                                 (sudo). The SHA-512 in base64 is optional.
  uninstall                      Remove OpenBot. The data stays (sudo).
  version                        Show the installed version.
EOF
}

service_user() {
  cat "$INSTALL/hosted/service-user" 2>/dev/null || echo openbot-nc
}

in_container() {
  [ -r "$INSTALL/hosted/mode" ] && [ "$(<"$INSTALL/hosted/mode")" = container ]
}

require_host() {
  in_container || return 0
  fail "In a container, $1. See docs/docker.md in the OpenBot source."
}

require_root() {
  [ "$(id -u)" -eq 0 ] || fail "Run this with sudo: sudo openbot-nc $*"
}

not_answering() {
  if in_container; then
    fail "OpenBot does not answer. Read the log on the host with: docker logs <container>"
  fi
  fail "OpenBot does not answer. Read the log with: openbot-nc logs"
}

not_running() {
  if start_loop_stopped; then
    fail "OpenBot stopped because its start failed again and again. Read the log with: openbot-nc logs
Install a new release with: sudo openbot-nc update <file or URL>. Or try again with: sudo openbot-nc restart"
  fi
  fail "OpenBot is not running. Start it with: sudo openbot-nc start"
}

wait_for_socket() {
  local second
  for ((second = 0; second < 30; second++)); do
    [ -S "$SOCKET" ] && return 0
    in_container || systemctl is-active --quiet "$UNIT" || not_running
    if ! in_container && safe_mode_running; then
      fail "OpenBot does not start, so it runs its safe mode: members see why. Read the log with: openbot-nc logs
Install a new release with: sudo openbot-nc update <file or URL>. Or try again with: sudo openbot-nc restart"
    fi
    if [ -d /run/openbot-nc ] && [ ! -x /run/openbot-nc ]; then
      fail "Run this with sudo, or as the user $(service_user)."
    fi
    sleep 1
  done
  not_answering
}

form_value() {
  printf '%s' "$1" | od -An -tx1 -v | tr -d ' \n' | sed 's/../%&/g'
}

control() {
  local method=$1 path=$2 field body="" arguments=()
  shift 2
  for field in "$@"; do body+="${body:+&}${field%%=*}=$(form_value "${field#*=}")"; done
  if [ "$#" -gt 0 ]; then
    arguments=(--header 'content-type: application/x-www-form-urlencoded' --data-binary @-)
  fi
  wait_for_socket
  response=$(printf '%s' "$body" | curl --silent --show-error --max-time 120 --unix-socket "$SOCKET" \
    -X "$method" "${arguments[@]}" --write-out 'status=%{http_code}\n' "http://openbot$path") ||
    not_answering
}

value() {
  sed -n "s/^$1=//p" <<<"$response" | head -n 1
}

check_answer() {
  [ "$(value status)" = 200 ] && return 0
  local message
  message=$(value message)
  if [ -z "$message" ]; then
    case $(value error) in
      invalid_path) message="Give the path of the identity file." ;;
      invalid_request) message="Give on or off." ;;
      invalid_name) message="Enter a server name." ;;
      identity_refused) message="OpenBot refused the identity file." ;;
      hosting_failed) message="OpenBot could not change the hosting." ;;
      *) message="OpenBot refused the request ($(value error))." ;;
    esac
  fi
  echo "$message" >&2
  return 1
}

show_status() {
  local identity server name message staged limit device
  identity=$(value identity)
  server=$(value server)
  name=$(value server_name)
  message=$(value server_message)
  device=$(value device)
  echo "OpenBot $(value version)"
  case $identity in
    ready) echo "Identity: user $(value user)${device:+ ($device)} in the team $(value team)" ;;
    missing) echo "Identity: none. Import an identity file with: openbot-nc import-identity <file>" ;;
    *) echo "Identity: OpenBot cannot use its identity file. $(value identity_message)" ;;
  esac
  if [ "$identity" = ready ]; then
    echo "Relay server: $(value relay)"
    if [ -n "$(value relay_message)" ]; then echo "  $(value relay_message)"; fi
  fi
  case $(value hosting) in
    on) echo "Hosting: on ($(value hosting_state))" ;;
    *) echo "Hosting: off. Share the agents with: openbot-nc hosting on" ;;
  esac
  if [ -n "$name" ]; then echo "Server: $name ($server)"; else echo "Server: $server"; fi
  if [ -n "$message" ]; then echo "  $message"; fi
  limit=$(value memory_limit)
  if [ -n "$limit" ]; then
    echo "Memory: $(($(value memory_available) / 1048576)) MiB free of $((limit / 1048576)) MiB ($(value memory_level))"
    turns=$(value turn_limit)
    if [ "$turns" = unlimited ]; then echo "Turns at the same time: no limit"; else echo "Turns at the same time: at most $turns"; fi
  fi
  staged=$(staged_version)
  if [ -n "$staged" ]; then echo "OpenBot $staged is ready to install. Run: sudo openbot-nc update <file or URL>"; fi
}

status_command() {
  control GET /v1/status
  check_answer || exit 1
  show_status
}

import_identity_command() {
  local file="" replace="" hosting="" path
  while [ "$#" -gt 0 ]; do
    case $1 in
      --replace)
        replace=1
        shift
        ;;
      --hosting)
        [ "$#" -ge 2 ] || fail "Add on or off after --hosting."
        case $2 in on | off) hosting=$2 ;; *) fail "Add on or off after --hosting." ;; esac
        shift 2
        ;;
      -*) fail "Unknown option: $1" ;;
      *)
        [ -z "$file" ] || fail "Give one identity file."
        file=$1
        shift
        ;;
    esac
  done
  [ -n "$file" ] || fail "Usage: openbot-nc import-identity <file> [--replace] [--hosting on|off]"
  path=$(readlink -f "$file") && [ -f "$path" ] || fail "$file is not a file."
  control POST /v1/identity "path=$path" ${replace:+"replace=1"}
  check_answer || exit 1
  if [ -n "$hosting" ]; then
    control POST /v1/hosting "enabled=$hosting"
    check_answer || exit 1
  fi
  show_status
}

logs_command() {
  require_host "read the log on the host with: docker logs <container>"
  if [ "${1:-}" = -f ]; then exec journalctl --unit "$UNIT" --follow --lines 100; fi
  exec journalctl --unit "$UNIT" --lines 200 --no-pager
}

restart_after_failed_update() {
  local status=$?
  trap '' INT TERM HUP
  [ ! -e "$INSTALL/.applying" ] || "$INSTALL/hosted/openbot-hosted-update" apply || true
  if systemctl start "$UNIT"; then
    echo "The update failed. OpenBot $(version_of "$INSTALL/app") runs. Try again with: sudo openbot-nc update <file or URL>" >&2
  else
    echo "The update failed, and OpenBot did not start. Read the log with: openbot-nc logs" >&2
  fi
  exit "$status"
}

update_command() {
  require_host "pull the new image on the host, then make the container again"
  require_root update
  local before after reply
  before=$(version_of "$INSTALL/app")
  [ -n "${1:-}" ] || fail "Usage: openbot-nc update <AppImage file or https URL> [SHA-512 in base64]"
  "$INSTALL/hosted/openbot-hosted-update" stage "$1" "${2:-}"
  after=$(staged_version)
  if [ -z "$after" ]; then
    echo "OpenBot $before is not older than the release that you gave."
    return 0
  fi
  if [ -t 0 ]; then
    read -rp "Install OpenBot $after now? OpenBot stops for about a minute, and running agent turns stop. [y/N] " reply
    [[ $reply == [yY]* ]] || return 0
  fi
  trap restart_after_failed_update EXIT
  trap 'exit 1' INT TERM HUP
  systemctl stop "$UNIT"
  "$INSTALL/hosted/openbot-hosted-update" apply
  trap - EXIT INT TERM HUP
  systemctl start "$UNIT"
  echo "Installed OpenBot $(version_of "$INSTALL/app")."
}

uninstall_command() {
  require_host "remove the container on the host. The data stays in its volume"
  require_root uninstall
  local user home reply unit entry
  { [ -r "$INSTALL/hosted/mode" ] && [ "$(<"$INSTALL/hosted/mode")" = self ]; } ||
    fail "This computer is not a self-hosted OpenBot server."
  user=$(service_user)
  if [ -t 0 ]; then
    read -rp "Remove OpenBot from this computer? The data of the user $user stays. [y/N] " reply
    [[ $reply == [yY]* ]] || return 0
  fi
  exec 9>"$LOCK"
  flock 9
  systemctl disable --now --quiet "${UNITS[@]}" 2>/dev/null || true
  for unit in "${UNITS[@]}"; do rm -f "/etc/systemd/system/$unit"; done
  systemctl daemon-reload
  if [ -f /etc/apparmor.d/openbot-nc-hosted ] && command -v apparmor_parser >/dev/null &&
    [ -d /sys/kernel/security/apparmor ]; then
    apparmor_parser --remove /etc/apparmor.d/openbot-nc-hosted 2>/dev/null || true
    if grep -qs '^# OpenBot-NC: ' /etc/apparmor.d/local/bwrap-userns-restrict; then
      sed -i -e '/^# OpenBot-NC: /d' -e '/^priority=1 allow pix \/\*\* -> &bwrap,$/d' \
        /etc/apparmor.d/local/bwrap-userns-restrict
      apparmor_parser --replace /etc/apparmor.d/bwrap-userns-restrict 2>/dev/null || true
    fi
  fi
  rm -f /etc/apparmor.d/openbot-nc-hosted /usr/local/bin/openbot-nc
  for entry in app hosted staged staged.ready .applying; do rm -rf "${INSTALL:?}/$entry"; done
  rmdir "$INSTALL" 2>/dev/null || true
  home=$(getent passwd "$user" | cut -d: -f6)
  echo "Removed OpenBot. The data stays in ${home:-the home folder of $user} and /srv/openbot-nc-hosted."
  echo "To install again with this data: the install command, with --user $user."
  echo "To delete the data too: sudo userdel --remove $user && sudo rm -rf /srv/openbot-nc-hosted"
}

command=${1:-}
[ "$#" -eq 0 ] || shift
case $command in
  status) status_command ;;
  import-identity) import_identity_command "$@" ;;
  hosting)
    case ${1:-} in on | off) ;; *) fail "Usage: openbot-nc hosting on|off" ;; esac
    control POST /v1/hosting "enabled=$1"
    check_answer || exit 1
    show_status
    ;;
  name)
    [ "$#" -ge 1 ] || fail "Usage: openbot-nc name <name>"
    control POST /v1/name "name=$*"
    check_answer || exit 1
    show_status
    ;;
  logs) logs_command "$@" ;;
  start | stop | restart)
    require_host "run docker $command <container> on the host"
    require_root "$command"
    systemctl "$command" "$UNIT"
    if [ "$command" = stop ]; then systemctl reset-failed "$UNIT" 2>/dev/null || true; fi
    ;;
  update)
    shift
    update_command "$@"
    ;;
  uninstall) uninstall_command ;;
  version) version_of "$INSTALL/app" ;;
  "" | help | --help | -h) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac
