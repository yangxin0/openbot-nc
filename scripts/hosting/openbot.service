[Unit]
Description=OpenBot hosted server
Wants=network-online.target openbot-nc-update-apply.service
After=network-online.target display-manager.service
ConditionPathExists=!/run/openbot-nc-pre-stop

[Service]
Type=simple
User=@SERVICE_USER@
RuntimeDirectory=openbot-nc
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/openbot-nc
ExecStartPre=-+/opt/OpenBot-NC/hosted/openbot-hosted-update trigger
ExecStart=/opt/OpenBot-NC/hosted/openbot-hosted-server
ExecStop=/opt/OpenBot-NC/hosted/openbot-hosted-server --stop
Restart=always
RestartSec=10
RestartPreventExitStatus=78
TimeoutStopSec=60
MemoryMax=90%
OOMScoreAdjust=-500
OOMPolicy=continue

[Install]
WantedBy=multi-user.target lightdm.service
